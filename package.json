{
  "name": "game-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "build:wasm": "pnpm --filter @game/rules build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check": "pnpm lint && pnpm build:wasm && pnpm typecheck && pnpm test",
    "test:e2e": "pnpm --filter @game/e2e test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
