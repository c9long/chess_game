{
  "name": "@game/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./migrate": "./src/migrate.ts",
    "./seed": "./src/seed.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "node src/migrate-cli.ts",
    "seed": "node src/seed-cli.ts",
