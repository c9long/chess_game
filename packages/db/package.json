    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@game/config": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
