# Settings for the $0 beta (infra/docker-compose.beta.yml, docs/DEPLOY-BETA.md). Copy to
# infra/.env (never commit it) and fill in every value. Generate each secret with:
#   openssl rand -hex 32
# Every server variable is documented in apps/server/.env.example.

# Your free DuckDNS name, e.g. mygame.duckdns.org (no https://). Caddy gets the certificate.
SITE_ADDRESS=yourname.duckdns.org
# The same name, as the web and API address (one origin: the server serves the web app).
API_PUBLIC_URL=https://yourname.duckdns.org
WEB_ORIGIN=https://yourname.duckdns.org
PASSKEY_RP_ID=yourname.duckdns.org
NATIVE_ORIGINS=

# No mail service: accounts are created through Google, Discord or GitHub; guests need nothing.
EMAIL_ACCOUNTS=false

# Database
DB_NAME=game
DB_USER=game
DB_PASSWORD=

# Secrets (each at least 32 random characters, all different)
BETTER_AUTH_SECRET=
IP_HASH_SECRET=

# Cloudflare Turnstile (free; widget for your DuckDNS name)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OAuth providers: at least one, or nobody can create an account. Empty hides a button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

LOG_LEVEL=info

# Error tracking (optional, free): docs/DEPLOY.md step 7. Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=

BOT_MIN_MOVE_MS=700

# Backups (infra/backup.sh) to Oracle Object Storage, free with the server account.
BACKUP_REMOTE=oci:game-backups
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=30
