# Settings for the no-sudo deployment (docs/DEPLOY-CSCLUB.md). setup.sh copies this file to
# ~/game/game.env and fills in the three random secrets for you. Fill in the rest, then keep
# a copy of the whole file in your password manager.
#
# Format: one KEY=value per line, no spaces around "=". If a value contains spaces or any
# of  $ ` " ' \ # ;  wrap it in single quotes: KEY='value'.

# Domains (see the guide): the web app on play.<domain>, the API on api.<domain>.
API_PUBLIC_URL=https://api.example.com
WEB_ORIGIN=https://play.example.com
PASSKEY_RP_ID=example.com

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> your tunnel -> install
# token). The tunnel's public hostname must point at http://127.0.0.1:<SERVER_PORT>.
# Empty = no tunnel (the game then only answers on this machine).
CLOUDFLARE_TUNNEL_TOKEN=

# Local ports, all bound to 127.0.0.1 only (nothing is opened to the internet). Change them
# only if setup.sh says one is taken.
SERVER_PORT=39300
BOT_PORT=39301
PG_PORT=39302
# PostgreSQL's socket folder (default ~/game/run/pg). Socket paths are limited to 107
# bytes, so if setup.sh says the path is too long, uncomment this:
# PG_SOCKET_DIR=/tmp/youruserid-game-pg

# Database. setup.sh runs a private PostgreSQL for you on 127.0.0.1:PG_PORT.
DB_NAME=game
DB_USER=game
# Letters, digits, - and _ only (it goes into a URL).
DB_PASSWORD=
# To use an external database instead (e.g. one made with `ceo postgresql create`), put its
# full URL here; setup.sh then skips the private PostgreSQL. See the guide first.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Secrets (each at least 32 random characters, all different). setup.sh fills them in.
BETTER_AUTH_SECRET=
IP_HASH_SECRET=

# Cloudflare Turnstile (real keys from the Cloudflare dashboard)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Resend; the free tier sends up to 100 emails a day)
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# Optional OAuth providers: leave empty to hide a provider's button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

LOG_LEVEL=info

# Bot pacing: minimum ms between the previous move and a bot's move.
BOT_MIN_MOVE_MS=700
# Bot search threads. Keep this small on a shared machine (each one can use a full core).
BOT_WORKERS=2

# Optional push alerts from the watchdog (restarts, crash loops, low disk, failed backups),
# for machines where cron can't send email. Either a Discord webhook URL (channel ->
# Settings -> Integrations -> Webhooks) or an ntfy topic such as
# https://ntfy.sh/<long-random-name> (free, no account; install the ntfy app and subscribe
# to the same topic). Treat the URL like a password. Empty = no push alerts.
ALERT_WEBHOOK_URL=

# How long running games may continue when the server is restarted for an update.
SHUTDOWN_DRAIN_MAX_SECONDS=2700

# Backups (backup.sh). BACKUP_AGE_RECIPIENT is required; BACKUP_REMOTE is optional (an
# rclone remote such as r2:game-backups; empty = keep backups on this machine only).
BACKUP_AGE_RECIPIENT=
BACKUP_REMOTE=
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_DAYS=7
