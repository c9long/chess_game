# Crontab for the no-sudo deployment (docs/DEPLOY-CSCLUB.md). Install it with:
#   crontab ~/game/current/scripts/crontab.example
# That REPLACES your crontab: if `crontab -l` already shows jobs, add these lines with
# `crontab -e` instead.
#
# Optional: cron emails you whatever a job prints. watchdog.sh prints only alerts
# (restarts, crash loops, low disk, failed backups). Set your address to get them (needs
# working mail on the machine), e.g. MAILTO=youruserid@csclub.uwaterloo.ca. Empty = no
# emails.
MAILTO=""

# Start everything when the machine boots.
@reboot $HOME/game/current/scripts/start.sh >> $HOME/game/logs/cron.log 2>&1

# Every minute: restart anything that died, rotate logs, check disk space.
* * * * * $HOME/game/current/scripts/watchdog.sh

# 03:15 every night: encrypted database backup (and upload, if BACKUP_REMOTE is set).
15 3 * * * $HOME/game/current/scripts/backup.sh >> $HOME/game/logs/backup.log 2>&1
