# Production settings for infra/docker-compose.yml. Copy to infra/.env (never commit it) and
# fill in every value. Generate each secret with:  openssl rand -hex 32
# (hex keeps the database password safe inside the DATABASE_URL).
# Every server variable is documented in apps/server/.env.example.

# Domains (see docs/DEPLOY.md): the web app on play.<domain>, the API on api.<domain>.
API_PUBLIC_URL=https://api.example.com
WEB_ORIGIN=https://play.example.com
PASSKEY_RP_ID=example.com
# Mobile apps (docs/MOBILE.md): leave empty until the Android/iOS apps exist, then set
# capacitor://localhost,https://localhost
NATIVE_ORIGINS=

# Compose profiles to start: "tunnel" runs cloudflared (keep it for production).
COMPOSE_PROFILES=tunnel

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel → install token)
CLOUDFLARE_TUNNEL_TOKEN=

# Database
DB_NAME=game
DB_USER=game
DB_PASSWORD=

# Secrets (each at least 32 random characters, all different)
BETTER_AUTH_SECRET=
IP_HASH_SECRET=

# Cloudflare Turnstile (real keys from the Cloudflare dashboard)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com

# Optional OAuth providers: leave empty to hide a provider's button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

LOG_LEVEL=info

# Error tracking (optional; docs/DEPLOY.md "Error reports and uptime checks"): the DSN of the
# Sentry project for the server. Empty = off. Leave the traces rate at 0 (errors only).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
# Only when this server also serves the web app (WEB_DIST_DIR): the DSN that web build was made
# with, so the page's CSP lets browsers send their reports.
VITE_SENTRY_DSN=

# Bot pacing: minimum ms between the previous move and a bot's move, so clients can play
# each move's animation (0 = bots move as soon as they have a move).
BOT_MIN_MOVE_MS=700

# Backups (infra/backup.sh)
BACKUP_REMOTE=r2:game-backups
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=30
