# Copy to apps/server/.env for local development (`pnpm --filter @game/server dev` loads it).
# Required: development, test or production. There is no default, so a deploy that forgets
# it fails to start instead of running with development secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Created by infra/dev-db.sh
DATABASE_URL=postgres://game:game_dev_password@localhost:5432/game_dev

# At least 32 random characters in staging/production (openssl rand -base64 48).
# Optional in development/test (a fixed dev-only secret is used).
BETTER_AUTH_SECRET=

# Public URL of the API as the browser reaches it. In dev the web app proxies /api to
# this server, so the browser-facing URL is the Vite origin. Prod (required, https): https://api.<domain>
API_PUBLIC_URL=http://localhost:5173
# The only origin allowed to call the API with credentials. Prod (required, https): https://play.<domain>
WEB_ORIGIN=http://localhost:5173
# Mobile app WebView origins (Capacitor), comma-separated; empty = none (the default). Added to
# CORS (without credentials: the apps sign in with a bearer token, never a cookie), Better
# Auth's trusted origins and the WebSocket origin check. Prod: capacitor://localhost,https://localhost (plain http is
# refused in production; dev live reload may add e.g. http://localhost).
NATIVE_ORIGINS=
# WebAuthn relying-party id. Prod (required): <domain>, the WEB_ORIGIN host or a parent of it.
PASSKEY_RP_ID=localhost

# true only behind Cloudflare (firewall admits only Cloudflare): client IP = CF-Connecting-IP.
# Required to be true in production; otherwise every client would share the proxy's IP.
TRUST_CLOUDFLARE=false
# Cannot be false in production.
RATE_LIMIT_ENABLED=true

# Cloudflare Turnstile. Dev/test default to Cloudflare's always-pass test keys
# (site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional override of the siteverify URL (development/test only; refused in production).
TURNSTILE_SITEVERIFY_URL=

# Email. Without RESEND_API_KEY nothing is sent: in development every email (verification,
# password reset) lands in the dev mailbox. Read it at http://localhost:5173/dev/mail
# (development only, loopback only). It is saved to apps/server/.dev-mailbox.json so server
# restarts keep it; set DEV_MAILBOX_FILE= (empty) to keep it in memory only.
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
# Email-and-password accounts (default true). false = no mail service: accounts come from OAuth
# only, guests still play, and production no longer needs RESEND_API_KEY (docs/DEPLOY-BETA.md).
EMAIL_ACCOUNTS=true
DEV_MAIL_ENDPOINT=true

# Pepper for the HMAC of IPs stored with legal acceptances. Required in production: at least
# 32 random characters, different from BETTER_AUTH_SECRET, kept outside the database and on
# the incident-response rotation list. Development/test derive one from the auth secret.
IP_HASH_SECRET=

# Guest purge job: guests inactive this many days are purged; 0 minutes disables the timer.
GUEST_INACTIVE_DAYS=30
GUEST_PURGE_INTERVAL_MINUTES=1440

# Abort matches a previous process left in progress, at startup. Keep it on (it can't be
# turned off in production); only a second test server sharing a live database turns it off.
# ABORT_ORPHANED_MATCHES=true

# OAuth providers are enabled only when both values are set.
# Redirect URI to register: <API_PUBLIC_URL>/api/auth/callback/<provider>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Lobbies and live games (Colyseus) ---
# bot-service base URL (`cargo run --release -p bot-service` listens on 127.0.0.1:7700).
# Unset (default): bots play quick local moves (captures of leaders first, then captures, else random).
# BOT_SERVICE_URL=http://127.0.0.1:7700
# Per bot-move request timeout; on timeout/503/unreachable the room plays a local move.
BOT_REQUEST_TIMEOUT_MS=4000
# Bot pacing: a bot's move is applied no earlier than this many ms after the previous move
# (2.2x as long after a defeat), so every move's animation plays and several bots in a row
# read naturally. The bot's think time overlaps the wait. In timed games the wait runs on
# the bot's own clock and is skipped when the bot is low on time. 0 = apply at once.
BOT_MIN_MOVE_MS=700
# Reconnect grace for disconnected players (in game: then abandon = timeout, or a bot takeover
# below; in a lobby: the seat is freed). Decimals allowed.
RECONNECT_GRACE_SECONDS=60
# AFK bot takeover: in casual multiplayer games, a player whose grace runs out while another
# human is still connected is replaced by a bot (they get the seat back if they rejoin)
# instead of being abandoned. Ranked and solo games always abandon. false = always abandon.
AFK_BOT_TAKEOVER=true
# Pre-game countdown after the host presses start.
COUNTDOWN_MS=3000
# Graceful shutdown (SIGTERM): running games may finish for this long, then they are aborted.
SHUTDOWN_DRAIN_MAX_SECONDS=2700
# Batch interval for writing match events to the database.
EVENT_FLUSH_INTERVAL_MS=250
# Periodic clock resync broadcast during games.
CLOCK_SYNC_INTERVAL_MS=5000
# Upper bound on concurrent lobby/game rooms in this process.
MAX_MATCH_ROOMS=500
# Development/test only (refused in production): replaces every time control's base time.
# DEV_CLOCK_BASE_MS=20000

# --- Moderation ---
# User ids (the `users.id` column, comma-separated) allowed to open the review queue at
# /admin/reports (dismiss reports, warn, reset usernames, suspend and unsuspend accounts).
# Empty (the default) = nobody. Find an id with: select id from users where username = '<name>';
ADMIN_USER_IDS=

# --- Single-origin deploy (optional) ---
# Folder of the built web app (apps/web/dist, built WITHOUT VITE_API_URL so it calls its own
# origin) for the server to serve next to the API: hashed /assets/* cached for a year,
# everything else revalidated, index.html for client-side routes; /api/* is never answered
# by it. Empty (the default) = off: the web app is hosted elsewhere (Cloudflare Pages, or the
# Vite dev server in development). It must exist and contain index.html, or startup fails.
# With it on, set API_PUBLIC_URL and WEB_ORIGIN to the same origin (e.g. both
# https://play.<domain>; production refuses to start otherwise) and PASSKEY_RP_ID to that host
# or its parent domain.
WEB_DIST_DIR=

# --- Error tracking (optional, Sentry) ---
# A Sentry project's DSN (Project settings → Client Keys (DSN)). Empty (the default) = off: the
# Sentry SDK is not even loaded. Reports are scrubbed before they leave the server: no user,
# IP or email, no cookies, headers, request bodies or query strings (packages/config
# src/error-scrub.ts). Every line logged at error level is reported (at most 30 an hour).
SENTRY_DSN=
# Environment name shown on each report (default: NODE_ENV, e.g. production).
SENTRY_ENVIRONMENT=
# Share of requests traced for performance, 0 to 1. 0 (the default) = errors only, which keeps
# within the free plan.
SENTRY_TRACES_SAMPLE_RATE=0
# With WEB_DIST_DIR on: the VITE_SENTRY_DSN the web build was made with (the web app's own
# Sentry project). The page's CSP then lets browsers report to its ingest host. Empty = the
# page allows no Sentry host, so a build made with a DSN can't send reports.
VITE_SENTRY_DSN=
